          }
        ],
        "rendered_text": "CFM.SRV.RefreshIndexProjections\n--- Steps ---\n   # Reset all index projections across all tables.\n   # ====================\n   \n   Set Error Capture [ Off ]\n   \n   # Gather table names\n   Set Variable [ $ListOfTables ; Value: SortValues ( ExecuteSQL ( \"SELECT TableName FROM FileMaker_Tables WHERE TableName LIKE 'TABLE%'\" ; \"\" ; \"\" ) ; 2 ) ]\n   Set Variable [ $ListOfTables.Count ; Value: ValueCount ( $ListOfTables ) ]\n   \n   # Interate thru each table name\n   Set Variable [ $i ; Value: 1 ]\n   Loop\n   \n   Exit Loop If [ $i > $ListOfTables.Count ]\n   \n   # Select the next table\n   Set Variable [ $Table ; Value: GetValue ( $ListOfTables ; $i ) ]\n   Exit Loop If [ IsEmpty ( $Table ) = True ]\n   \n   # switch to table layout\n   Go to Layout [ \"CFM.INT.\" & $Table ]\n   \n   # update records\n   If [ Get ( LastError ) = 0\nand Get ( TotalRecordCount ) > 0 ]\n   Show All Records\n   Go to Record/Request/Page [ First ]\n   Open Transaction\n   Loop\n   Set Field By Name [  ; $Table & \"::JSONOfRecord\" ; Calculation: GetField ( $Table & \"::JSONOfRecord\" ) ]\n   Exit Loop If [ Get ( RecordNumber ) = Get ( FoundCount ) ]\n   Go to Record/Request/Page [ Next ; Exit after last ]\n   End Loop\n   Commit Transaction\n   End If\n   \n   # Advance iteration\n   Set Variable [ $i ; Value: $i + 1 ]\n   \n   End Loop\n   \n   Exit Script [ \"Complete: \" & $i - 1 & \" tables updated\" ]\n   ",
        "summary": null,
        "is_folder": false,
        "folder_path": [
          "CORPUSfm_DB (CFM)",
          "CFM.SERVER (SRV)"
        ],
        "dead_end": true,
        "has_calc": false
      },
