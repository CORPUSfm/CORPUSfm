        "rendered_text": "CFM.SRV.MoveContainerData\n--- Steps ---\n   # FM-internal container move\n   # ====================\n   # This script is used by CORPUSfm to container date between tables.\n   # CORPUSfm will call this script providing json parameters for work targets.\n   # Parameters:\n   # {\n   #   \"source\": {\"table\": \"TABLE8\", \"uuid\": \"<record UUID>\", \"field\": \"ContainerField0\"},\n   #   \"target\": {\"table\": \"TABLE0\", \"uuid\": \"<record UUID>\", \"field\": \"ContainerField2\"},\n   #   \"clear_source\": false\n   # }\n   # ====================\n   \n   Set Error Capture [ Off ]\n   \n   # validate income parameters\n   If [ CFM.TOOLS.IsValidJSON ( Get ( ScriptParameter ) ) = False\nor IsEmpty ( JSONGetElement ( Get ( ScriptParameter ) ; \"source\" ) ) = True\nor IsEmpty ( JSONGetElement ( Get ( ScriptParameter ) ; \"target\" ) ) = True ]\n   Exit Script [ \"FATAL: Bad parameters\" ]\n   End If\n   \n   # convert parameters to variables\n   Set Variable [ $json ; Value: Get ( ScriptParameter ) ]\n   Set Variable [ $source.table ; Value: JSONGetElement ( $json ; \"source.table\" ) ]\n   Set Variable [ $source.uuid ; Value: JSONGetElement ( $json ; \"source.uuid\" ) ]\n   Set Variable [ $source.field ; Value: JSONGetElement ( $json ; \"source.field\" ) ]\n   Set Variable [ $target.table ; Value: JSONGetElement ( $json ; \"target.table\" ) ]\n   Set Variable [ $target.uuid ; Value: JSONGetElement ( $json ; \"target.uuid\" ) ]\n   Set Variable [ $target.field ; Value: JSONGetElement ( $json ; \"target.field\" ) ]\n   \n   Open Transaction\n   # find source layout\n   Go to Layout [ \"CFM.INT.\" & $source.table ]\n   If [ Get ( LayoutTableName ) ≠ $source.table\nor IsEmpty ( $source.table ) = True ]\n   Exit Script [ \"FATAL: Source table not found\" ]\n   End If\n   \n   # find source record\n   Enter Find Mode [ Pause: Off ]\n   Set Field By Name [  ; $source.table & \"::UUID\" ; Calculation: \"=\" & $source.uuid ]\n   Perform Find\n   If [ Get ( LastError ) > 0\nor IsEmpty ( $source.uuid ) = True ]\n   Exit Script [ \"FATAL: Source uuid not found\" ]\n   End If\n   \n   # find source field\n   Set Variable [ $data ; Value: GetField ( $source.table & \"::\" & $source.field ) ]\n   Set Field By Name [  ; $source.table & \"::\" & $source.field ; Calculation: \"\" ]\n   If [ IsEmpty ( $data ) = True\nor IsEmpty ( $source.field ) = True ]\n   Exit Script [ \"FATAL: Source field not found\" ]\n   End If\n   \n   # find target layout\n   Go to Layout [ \"CFM.INT.\" & $target.table ]\n   If [ Get ( LayoutTableName ) ≠ $target.table\nor IsEmpty ( $target.table ) = True ]\n   Exit Script [ \"FATAL: Target table not found\" ]\n   End If\n   \n   # find target record\n   Enter Find Mode [ Pause: On ]\n   Set Field By Name [  ; $target.table & \"::UUID\" ; Calculation: \"=\" & $target.uuid ]\n   Perform Find\n   If [ Get ( LastError ) > 0\nor IsEmpty ( $target.uuid ) = True ]\n   Exit Script [ \"FATAL: Target uuid not found\" ]\n   End If\n   \n   # find target field\n   Set Field By Name [  ; $target.table & \"::\" & $target.field ; Calculation: $data ]\n   If [ IsEmpty ( $data ) = True\nor IsEmpty ( $source.field ) = True ]\n   Exit Script [ \"FATAL: Target field not found\" ]\n   End If\n   Commit Transaction\n   If [ Get ( LastError ) > 0 ]\n   Exit Script [ \"FATAL: Transaction failed\" ]\n   End If\n   \n   Exit Script [ \"Success\" ]\n   ",
        "summary": null,
        "is_folder": false,
        "folder_path": [
          "CORPUSfm_DB (CFM)",
          "CFM.SERVER (SRV)"
        ],
        "dead_end": true,
        "has_calc": false
      },
