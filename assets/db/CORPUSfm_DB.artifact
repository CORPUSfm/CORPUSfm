        "rendered_text": "CFM.TOOLS.AutoenterCalculation ( GetFieldNam )\n  Parameters: GetFieldNam\n  Access: All\n\n  /**\n  \n  \tAutoEnter calculation for general use.\n  \n  */\n  \n  Let (\n  [\n  \t// gather info from current field\n  \t~fieldThis = GetFieldNam\n  \t; ~fieldContent = GetField ( ~fieldThis )\n  \t; ~listOfField = Substitute ( ~fieldThis ; \"::\" ; ¶ )\n  \t; ~tableName = GetValue ( ~listOfField ; 1 )\n  \t; ~fieldName = GetValue ( ~listOfField ; 2 )\n  \t; ~fieldType = Case(\n  \t\tPatternCount ( ~fieldName ; \"Text\" ) > 0\n  \t\t; \"Text\";\n  \t\tPatternCount ( ~fieldName ; \"Number\" ) > 0\n  \t\t; \"Number\";\n  \t\tPatternCount ( ~fieldName ; \"Date\" ) > 0\n  \t\t; \"Date\";\n  \t\tPatternCount ( ~fieldName ; \"Timestamp\" ) > 0\n  \t\t; \"Timestamp\";\n  \t\tPatternCount ( ~fieldName ; \"Time\" ) > 0\n  \t\t; \"Time\";\n  \t\t\"Ignore\"\n  \t\t)\n  \n  \t// pull column mapping from setting table\n  \t; ~calculations = ExecuteSQL ( \"SELECT JSONOfRecord FROM SETTING\" ; \"\" ; \"\" )\n  \t; ~calculations = Case (\n  \t\tIsEmpty ( JSONGetElement ( ~calculations ; \"ThisShouldBeNothing\" ) ) = False\n  \t\t; \"{}\";\n  \t\t~calculations\n  \t\t)\n  \n  \t// build calculation for field\n  \t; ~keyOrIndexOrPath = Case (\n  \t\t~calculations = \"{}\"\n  \t\t; \"ThisIsNothing\";\n  \t\t\"Calculations.\" & ~tableName & \".\" & ~fieldType & \".\" & ~fieldName\n  \t\t)\n  \t; ~calc = JSONGetElement ( ~calculations ; ~keyOrIndexOrPath )\n  \n  \t// return result of existing calculation or Self\n  \t; ~output = Case (\n  \t\tIsEmpty( ~calc ) = False and ~fieldType = \"Text\"\n  \t\t; Lower ( Evaluate ( ~calc ) );\n  \n  \t\tIsEmpty( ~calc ) = False\n  \t\t; Evaluate ( ~calc );\n  \n  \t\t~fieldContent\n  \t\t)\n  ];\n  \t~output\n  )",
