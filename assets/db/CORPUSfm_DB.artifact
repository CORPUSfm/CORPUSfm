        "xml_sources": [
          {
            "catalog": "CustomFunctionsCatalog",
            "xml": "<CustomFunction id=\"4\" name=\"CFM.TOOLS.AutoenterCalculation\" access=\"All\">\n\t\t\t\t\t\t<UUID modifications=\"1\" userName=\"CORPUSfm\" accountName=\"Admin\" timestamp=\"2026-08-13T22:32:32\">9971EA32-8FBD-4BED-8BB5-15A06E111503</UUID>\n\t\t\t\t\t\t<SourceUUID>731255F7-C75B-4FA6-9FA8-4D9F4DFB155B</SourceUUID>\n\t\t\t\t\t\t<TagList />\n\t\t\t\t\t\t<Calculation>\n\t\t\t\t\t\t\t<DDRREF kind=\"ChunkList\" hash=\"4BEAFC5BED90191C0AF5DE5B6DE5CDA0\">_9971EA32-8FBD-4BED-8BB5-15A06E111503</DDRREF>\n\t\t\t\t\t\t\t<Text>/**\n\n\tAutoEnter calculation for general use.\n\n*/\n\nLet (\n[\n\t// gather info from current field\n\t~fieldThis = GetFieldNam\n\t; ~fieldContent = GetField ( ~fieldThis )\n\t; ~listOfField = Substitute ( ~fieldThis ; \"::\" ; ¶ )\n\t; ~tableName = GetValue ( ~listOfField ; 1 )\n\t; ~fieldName = GetValue ( ~listOfField ; 2 )\n\t; ~fieldType = Case(\n\t\tPatternCount ( ~fieldName ; \"Text\" ) &gt; 0\n\t\t; \"Text\";\n\t\tPatternCount ( ~fieldName ; \"Number\" ) &gt; 0\n\t\t; \"Number\";\n\t\tPatternCount ( ~fieldName ; \"Date\" ) &gt; 0\n\t\t; \"Date\";\n\t\tPatternCount ( ~fieldName ; \"Timestamp\" ) &gt; 0\n\t\t; \"Timestamp\";\n\t\tPatternCount ( ~fieldName ; \"Time\" ) &gt; 0\n\t\t; \"Time\";\n\t\t\"Ignore\"\n\t\t)\n\n\t// pull column mapping from setting table\n\t; ~calculations = ExecuteSQL ( \"SELECT JSONOfRecord FROM SETTING\" ; \"\" ; \"\" )\n\t; ~calculations = Case (\n\t\tIsEmpty ( JSONGetElement ( ~calculations ; \"ThisShouldBeNothing\" ) ) = False\n\t\t; \"{}\";\n\t\t~calculations\n\t\t)\n\n\t// build calculation for field\n\t; ~keyOrIndexOrPath = Case (\n\t\t~calculations = \"{}\"\n\t\t; \"ThisIsNothing\";\n\t\t\"Calculations.\" &amp; ~tableName &amp; \".\" &amp; ~fieldType &amp; \".\" &amp; ~fieldName\n\t\t)\n\t; ~calc = JSONGetElement ( ~calculations ; ~keyOrIndexOrPath )\n\n\t// return result of existing calculation or Self\n\t; ~output = Case (\n\t\tIsEmpty( ~calc ) = False and ~fieldType = \"Text\"\n\t\t; Lower ( Evaluate ( ~calc ) );\n\n\t\tIsEmpty( ~calc ) = False\n\t\t; Evaluate ( ~calc );\n\n\t\t~fieldContent\n\t\t)\n];\n\t~output\n)</Text>\n\t\t\t\t\t\t</Calculation>\n\t\t\t\t\t\t<Display>CFM.TOOLS.AutoenterCalculation ( GetFieldNam )</Display>\n\t\t\t\t\t\t<ObjectList membercount=\"1\">\n\t\t\t\t\t\t\t<Parameter name=\"GetFieldNam\" />\n\t\t\t\t\t\t</ObjectList>\n\t\t\t\t\t</CustomFunction>\n\t\t\t\t\t"
