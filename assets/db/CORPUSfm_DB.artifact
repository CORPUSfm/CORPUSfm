        "rendered_text": "CFM.SRV.ChangeAutomationPassword\n--- Steps ---\n   # This script is used by CORPUSfm to randomize the CORPUSfm-Automation account password.\n   # CORPUSfm will call this script providing a new password only it will know.\n   # This script must be granted full access privileges\n   # Parameters: { \"password\": \"...\" }\n   # ====================\n   \n   Set Error Logging [ On ]\n   Set Error Capture [ Off ]\n   \n   If [ CFM.TOOLS.IsValidJSON ( Get ( ScriptParameter ) ) = False\nor IsEmpty ( JSONGetElement ( Get ( ScriptParameter ) ; \"password\" ) ) = True ]\n   Exit Script [ \"FATAL: Bad parameters\" ]\n   End If\n   \n   Reset Account Password [ Name: \"CORPUSfm-Automation\" ; Password: JSONGetElement ( Get ( ScriptParameter ) ; \"password\" ) ]\n   \n   If [ Get ( LastError ) = 0 ]\n   Exit Script [ \"Ok\" ]\n   Else\n   Exit Script [ \"FATAL: Reset failed\" ]\n   End If\n   ",
        "summary": null,
        "is_folder": false,
        "folder_path": [
          "CORPUSfm_DB (CFM)",
          "CFM.SERVER (SRV)"
        ],
